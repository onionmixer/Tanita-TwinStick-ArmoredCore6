#include <windows.h>
#include "Resources.h"

IDI_TANITA ICON "Tanita.ico"
IDR_TWIN_STICK_MAP RCDATA "twin-stick-map.png"

IDD_CAPTURE_INPUT DIALOGEX 0, 0, 316, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Capture Twin Stick input"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "",IDC_CAPTURE_ACTION,12,12,292,12
    LTEXT           "",IDC_CAPTURE_STATUS,12,32,292,24
    LTEXT           "",IDC_CAPTURE_LIVE,12,60,292,13
    LTEXT           "",IDC_CAPTURE_RESULT,12,78,292,18
    PUSHBUTTON      "Retry",IDC_CAPTURE_RETRY,85,108,61,14
    DEFPUSHBUTTON   "Save mapping",IDOK,154,108,82,14
    PUSHBUTTON      "Cancel",IDCANCEL,244,108,60,14
END
